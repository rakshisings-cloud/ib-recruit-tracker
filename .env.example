# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Resend API key (https://resend.com) for sending alert emails
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address alerts are sent to and from
ALERT_TO_EMAIL=you@example.com
ALERT_FROM_EMAIL=alerts@yourdomain.com

# GitHub repo + PAT used by the dashboard's "Check Now" button to dispatch
# the scrape workflow for browser-strategy firms (repo scope, or fine-grained
# with Actions: read/write on this repo)
GITHUB_OWNER=your-github-username
GITHUB_REPO=ib-recruit-tracker
GITHUB_DISPATCH_TOKEN=ghp_xxxxxxxxxxxx

# Set this on Vercel only (not needed locally or in GitHub Actions). Vercel's
# build installs devDependencies, including playwright, whose postinstall
# script downloads a ~300MB Chromium binary by default. Vercel never actually
# launches a browser (that only happens in the GitHub Actions workflow, which
# runs its own explicit `playwright install`), so skip the download there to
# keep the Vercel build fast and small.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
